# ─────────────────────────────────────────────────────────────
# ClkLog 部署模板 .env（源码仓 deploy/compose-template 专用）
# ⚠️ 本文件是模板：CLKLOG_VER 为占位符 VER_PLACEHOLDER，直接部署会拉取失败。
#    部署前请将 VER_PLACEHOLDER 改为目标版本号（如 v1.4.1）或 latest。
#    想开箱即用，请直接用 Release 的 clklog-docker-compose-<tag>.tar.gz（已替好版本号）。
# ─────────────────────────────────────────────────────────────
#[Clickhouse]
CK_USER_NAME=default
CK_USER_PWD=clklogpwd

#[ClkLog]
